{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!apps/desktop/src-tauri/gen",
      "!apps/mobile/android",
      "!reports",
      "!.ddh",
      "!assets/game-art/layered-map-poc/metadata",
      "!docs/visual-evidence/battlefield-language/current",
      "!docs/visual-evidence/running-client/shuttergate-normal-motion-clip.json",
      "!docs/visual-evidence/running-client/shuttergate-reduced-motion-clip.json",
      "!docs/visual-evidence/release-closeout"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  }
}
